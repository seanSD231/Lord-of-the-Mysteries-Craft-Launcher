{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lord of the Mysteries Craft",
  "version": "0.1.0",
  "identifier": "com.lotmcraft.launcher",
  "mainBinaryName": "lotmcraft-gui",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Lord of the Mysteries Craft",
        "width": 1000,
        "height": 540,
        "resizable": false,
        "center": true,
        "maximizable": false,
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "shortDescription": "Launcher for the Lord of the Mysteries Craft modpack"
  }
}