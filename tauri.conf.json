{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lord of the Mysteries Craft",
  "version": "0.1.0",
  "identifier": "com.lotmcraft.launcher",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      {
        "title": "Lord of the Mysteries Craft",
        "width": 900,
        "height": 600,
        "resizable": true,
        "minWidth": 840,
        "minHeight": 560,
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
